# Environment — copy this to .env and fill in real values

# ─── Cluster identity ─────────────────────────────────────────────────────────
CLUSTER_ID=local-kind

# ─── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=K8S_EVENTS
NATS_CONSUMER_NAME=INDEXER
NATS_DLQ_SUBJECT=k8s.dlq

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=k8s_ops
POSTGRES_USER=k8s_ops
POSTGRES_PASSWORD=changeme

# ─── Embedding ────────────────────────────────────────────────────────────────
# Model name must be a sentence-transformers compatible model ID.
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
# Change EMBEDDING_DIM to match the chosen model's output dimensions.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ─── LLM (Groq) ───────────────────────────────────────────────────────────────
# Get a free key at: https://console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ─── API / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=3600
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=k8s-ops-assistant

# ─── Log level ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
